# Mistral AI API Key (Required for LLM summarization, extraction, and RAG chat)
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Required for Hinglish / Indian language audio transcription)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# Whisper Model (Optional: tiny, base, small, medium, large - defaults to small)
WHISPER_MODEL=small
